# =========================
# Unity generated folders
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
Il2cppBuildCache/

# Unity Package cache (sometimes leaks large binaries)
Library/PackageCache/

# Asset meta data should only be ignored when the corresponding asset is ignored
!/[Aa]ssets/**/*.meta

# =========================
# Autogenerated files
# =========================
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# =========================
# OS generated files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Rider / VS Code / Visual Studio
# =========================
.vscode/
.idea/
*.vsconfig
.vs/

# =========================
# Unity crash reports
# =========================
sysinfo.txt
crashlytics-build.properties

# =========================
# Addressables & Shader cache
# =========================
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.json
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.hash
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bundle*

# =========================
# Gradle (Android)
# =========================
.gradle/
**/gradle-wrapper.jar
/build/

# =========================
# User-specific settings
# =========================
UserSettings/
